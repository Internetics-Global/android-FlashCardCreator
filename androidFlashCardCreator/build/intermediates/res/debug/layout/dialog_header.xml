<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:id="@+id/main_relativelayout_header"
             android:layout_width="fill_parent"
             android:layout_height="40dp"
             android:background="@drawable/image_dialog_head_bg">

    <Button
            android:id="@+id/dialog_head_close_btn"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textSize="12sp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="10.0dip"
            android:background="@drawable/selector_black_button"
            style="@style/BlackButtonText"
            android:text="Close"/>

    <TextView
            android:id="@+id/dialog_title"
            style="@style/dialog_head_title"
            android:layout_gravity="center"
            android:text=""/>


    <Button
            android:id="@+id/dialog_head_save_btn"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textSize="12sp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="10.0dip"
            android:background="@drawable/selector_black_button"
            style="@style/BlackButtonText"
            android:text="Save"/>
</FrameLayout>
