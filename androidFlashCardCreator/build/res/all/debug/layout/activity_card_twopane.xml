<merge xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
        >

    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:baselineAligned="false"
                  android:divider="?android:attr/dividerHorizontal"
                  android:orientation="horizontal"
                  android:showDividers="none"
                  android:background="@drawable/w2048"
                  tools:context=".MainActivity">

        <FrameLayout
                android:id="@+id/card_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null">

            <fragment
                    android:id="@+id/fragment_card_list"
                    android:name="com.internectics.fragment.CardListFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:layout="@android:layout/list_content"/>

            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="bottom">

                <Button
                        android:enabled="false"
                        android:layout_height="match_parent"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:background="@drawable/image_add_card_button_bg">

                </Button>

                <Button
                        android:id="@+id/add_card_button"
                        android:layout_width= "60dp"
                        android:layout_height= "60dp"
                        android:layout_gravity="center"
                        android:background="@drawable/selector_add_card"/>

            </FrameLayout>

            <Button
                    android:id="@+id/master_view_mask"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E0000000"
                    android:visibility="invisible">
            </Button>

            <LinearLayout
                    android:id="@+id/master_view_updating_layout"
                    android:layout_width="114dp"
                    android:layout_height="70dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:orientation="vertical"
                    android:background="@drawable/button_updating_background"
                    android:visibility="invisible"
                    android:gravity="center"
                    android:layout_gravity="center">

                <ProgressBar
                        android:id="@+id/master_view_updating_progressBar"
                        android:layout_marginTop="5dp"
                        android:layout_width="114dp"
                        android:layout_height="40dp"
                        android:indeterminate="true"
                        style="?android:attr/progressBarStyle"
                        android:gravity="center"
                        android:layout_gravity="center"
                        ></ProgressBar>

                <TextView
                        android:layout_width="114dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:enabled="false"
                        android:text="@string/alert_applying_to_all_cards"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        >
                </TextView>


            </LinearLayout>


        </FrameLayout>

        <FrameLayout

                android:layout_width="0dp"
                android:id="@+id/detail"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@null">

            <FrameLayout
                    android:id="@+id/card_detail_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

            </FrameLayout>

            <FrameLayout
                    android:id="@+id/add_card_frame_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible"
                    android:background="@drawable/w2048">

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

    <fragment
            android:id="@+id/fragment_symbol_box"
            android:name="com.internectics.fragment.SymbolBoxFragment"
            android:background="#d5d7d9"
            android:layout_gravity="bottom"
            android:layout_marginBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/symbol_box_height"
        tools:layout="@layout/fragment_symbol_box" />



</merge><!-- From: file:/Users/bournewang/Documents/Project/gradle/android-FlashCardCreator/androidFlashCardCreator/src/main/res/layout/activity_card_twopane.xml -->