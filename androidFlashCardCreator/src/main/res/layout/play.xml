<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/play_baseview"
                android:layout_width="match_parent"
                android:background="@drawable/w2048"
                android:layout_height="match_parent">

    <com.internectics.util.VGViewPager
            android:id="@+id/viewpager"
            android:layout_width="fill_parent"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_height="fill_parent" />

    <View
            android:id="@+id/play_mask"
            android:layout_width="fill_parent"
            android:paddingLeft="0dp"
            android:clickable="false"
            android:paddingRight="0dp"
            android:paddingTop="0dp"
            android:background="#00FFFFFF"
            android:paddingBottom="0dp"
            android:layout_height="fill_parent" />

    <include
        android:id="@+id/play_control_panel"
        android:layout_marginBottom="15dp"
        android:layout_gravity="center_horizontal|bottom"
        layout="@layout/play_control_panel"
        android:layout_width="480dp"
        android:layout_height="30dp" />


    <TextView
        android:textColor="@android:color/white"
        android:layout_marginLeft="30dp"
        android:layout_marginBottom="30dp"
        android:layout_width="wrap_content"
        android:textSize="40sp"
        android:visibility="invisible"
        android:layout_height="wrap_content"
        android:id="@+id/count_down_textview"
        android:layout_gravity="left|bottom"
        android:text="N"/>


</FrameLayout>