<resources>

    <!-- Application theme. -->
    <style name="FCCTheme" parent="android:Theme.Holo">
    </style>

    <!-- Dialog head title-->
    <style name="dialog_head_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dialog_head_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:shadowColor">#ffffffff</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <!-- Black button style -->
    <style name="BlackButtonText">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>


    </style>


    <style name="ToolTipLayoutCustomStyle_orange">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#fff46916</item>
        <item name="ttlm_backgroundColor">#fff46916</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_orange_light">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ffe3911e</item>
        <item name="ttlm_backgroundColor">#ffe3911e</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_purple">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ff69006c</item>
        <item name="ttlm_backgroundColor">#ff69006c</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_pink">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#fff371cf</item>
        <item name="ttlm_backgroundColor">#fff371cf</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_blue">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ff3e77d1</item>
        <item name="ttlm_backgroundColor">#ff3d77d1</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_cyan">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ff3d77d1</item>
        <item name="ttlm_backgroundColor">#ff3d77d1</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_green">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ff086f1e</item>
        <item name="ttlm_backgroundColor">#ff086f1e</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_cyan_light">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ff9ea215</item>
        <item name="ttlm_backgroundColor">#ff9ea215</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>

    <style name="ToolTipLayoutCustomStyle_cyan_dark">
        <item name="ttlm_padding">15dip</item>
        <item name="ttlm_strokeColor">#ff696b1c</item>
        <item name="ttlm_backgroundColor">#ff696b1c</item>
        <item name="ttlm_strokeWeight">0dip</item>
        <item name="ttlm_cornerRadius">2dip</item>
    </style>


    <style name="CardBodyEditTextCustomStyle" parent="@android:style/Widget.EditText">
        <item name="android:textCursorDrawable">@drawable/color_cursor</item>
    </style>


    <!-- 操作项样式 start -->
    <style name="option_item_rl">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@android:color/black</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingLeft">13.0dp</item>
        <item name="android:paddingTop">3.0dp</item>
        <item name="android:paddingBottom">3.0dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="option_item_toggleButton">
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">30dp</item>
    </style>


    <style name="option_item_text_parent">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#333</item>
        <item name="android:clickable">false</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textSize">16dip</item>
    </style>

    <style name="CustomSeekbarTextAppearance" parent="android:TextAppearance.Small">
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>

    </style>

    <style name="AppTheme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>