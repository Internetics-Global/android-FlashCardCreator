<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/pack_list_item_width"
    android:layout_height="@dimen/pack_list_height">

    <EditText
        android:id="@+id/pack_name_text"
        android:layout_width="@dimen/pack_list_item_width"
        android:layout_height="0dp"
        android:layout_weight="25"
        android:text="default"
        android:enabled="false"
        android:textSize="@dimen/pack_list_text_size"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:editable="false"
        android:background="@android:color/transparent"
        android:layout_marginTop="10dp">

    </EditText>

    <FrameLayout
        android:id="@+id/pack_item_layout"
        android:layout_width="fill_parent"
        android:layout_marginTop="5dp"
        android:layout_height="0dp"
        android:layout_weight="100"
        android:orientation="horizontal"
        >

        <ImageView
            android:layout_margin="2dp"
            android:id="@+id/pack_cover_image"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/default_pack_cover_image"
            android:background="@drawable/shape_image_round_corner">

        </ImageView>

        <ImageView
            android:id="@+id/pack_play_image_view"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="15dp"
            android:layout_marginRight="15dp"
            android:layout_gravity="bottom|right"
            android:scaleType="fitCenter"
            android:src="@drawable/pack_list_play">
        </ImageView>

        <ImageView
            android:id="@+id/goto_pack_image_view"
            android:visibility="visible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="15dp"
            android:layout_marginLeft="15dp"
            android:layout_gravity="bottom|left"
            android:scaleType="fitCenter"
            android:src="@drawable/pack_list_edit">
        </ImageView>


        <ImageView
            android:layout_gravity="right|top"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:id="@+id/pack_lock_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/lock">

        </ImageView>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/pack_list_edit_layout"
        android:layout_width="fill_parent"
        android:layout_height="25dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        >

        <ImageButton
            android:id="@+id/button_delete_pack"
            android:layout_marginRight="10dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:src="@drawable/delete_button"
            android:layout_weight="50">

        </ImageButton>

        <ImageButton
            android:id="@+id/button_edit_pack"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:src="@drawable/edit_pack_button"
            android:layout_weight="50">

        </ImageButton>

    </LinearLayout>

</LinearLayout>