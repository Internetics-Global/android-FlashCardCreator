<?xml version="1.0" encoding="utf-8"?>

<com.daimajia.swipe.SwipeLayout xmlns:fbutton="http://schemas.android.com/apk/res-auto"
                                xmlns:android="http://schemas.android.com/apk/res/android"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
    >

    <LinearLayout
        android:background="@android:color/holo_red_dark"
        android:id="@+id/right_to_left"
        android:layout_width="90dp"
        android:layout_height="match_parent">

        <TextView
            android:text="Delete"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_width="70dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_height="match_parent"
            android:id="@+id/card_list_item_swipe_delete"
            />

    </LinearLayout>


    <LinearLayout
        android:background="#1db61f"
        android:id="@+id/left_to_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:text="Copy"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_width="70dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_height="match_parent"
            android:id="@+id/card_list_item_swipe_copy"
            />


    </LinearLayout>

    <include
        layout="@layout/card_list_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />



</com.daimajia.swipe.SwipeLayout>