<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/RelativeLayout01"
    android:layout_width="fill_parent"
    android:layout_height="130dip"
    android:background="@android:color/black"
    android:orientation="horizontal"
    android:paddingBottom="4dip" >

    <TextView
        android:id="@+id/CardItemSN"
        android:layout_width="20dip"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="16dp"
        android:background="@drawable/card_list_item_background"
        android:gravity="center"
        android:text="1"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/CardItemImage"
        android:layout_width="160dip"
        android:layout_height="104dip"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="17dp"
        android:background="@drawable/shape_card_list_item"
        android:scaleType="fitXY"
        android:src="@drawable/test_card_coverage" />

</LinearLayout>