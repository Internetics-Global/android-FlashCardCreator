<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        android:id="@+id/RelativeLayout01"
        android:layout_width="fill_parent"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_background"
        android:layout_height="fill_parent">

    <include layout="@layout/dialog_header"/>

    <Gallery android:id="@+id/pack_list_gallery"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginLeft="5dp"
             android:layout_marginRight="5dp"
             android:gravity="center_vertical"
             android:spacing="16dp"
            />

    <FrameLayout
        android:layout_height="50dp"
        android:layout_marginBottom="0dp"
        android:layout_width="match_parent">

        <Button
        android:id="@+id/new_user_btn"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:textSize="12sp"
        android:layout_gravity="left|bottom"
        android:layout_marginLeft="10dp"
        android:background="@null"
        style="@style/BlackButtonText"
        android:text="New User?"/>


        <Button
            android:id="@+id/sort_btn"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:textSize="12sp"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="10dp"
            android:background="@null"
            style="@style/BlackButtonText"
            android:text="Sorted by recently viewed first"/>


        </FrameLayout>

</LinearLayout>