<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main_relativelayout_header" 
  	android:layout_width="fill_parent"
  	android:layout_height="40dip"
  	android:background="@drawable/dialog_head_bg">
  	
    <Button
    	android:id="@+id/dialog_head_close_btn"
  		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
        android:layout_gravity="left"
		android:layout_marginLeft="5.0dip"
        android:background="@drawable/blackbutton"
        style="@style/BlackButtonText"
        android:text="Close"/>
    
    <TextView
        android:id="@+id/dialog_title"
        style="@style/dialog_head_title"
		android:layout_gravity="center"
		android:text="Add a new pack"/>

    
    <Button
    	android:id="@+id/dialog_head_save_btn"
  		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
        android:layout_gravity="right"
		android:layout_marginRight="5.0dip"
        android:background="@drawable/blackbutton"
        style="@style/BlackButtonText"
		android:text="Save"/>
</FrameLayout>
